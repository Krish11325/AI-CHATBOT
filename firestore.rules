rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Root User profile document
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // User-specific subcollection: studyProgress
      match /studyProgress/{topicId} {
        allow read, write: if isOwner(uid);
      }

      // User-specific subcollection: quizResults
      match /quizResults/{quizId} {
        allow read, write: if isOwner(uid);
      }

      // User-specific subcollection: notes
      match /notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      // User-specific subcollection: bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(uid);
      }

      // User-specific subcollection: conversations
      match /conversations/{conversationId} {
        allow read, write: if isOwner(uid);

        // Messages inside conversations
        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
